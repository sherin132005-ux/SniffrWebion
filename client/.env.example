# Leave blank for local dev — api.js/socket.js fall back to same-origin requests,
# proxied by Vite to the backend (see vite.config.js).
# Required in production (Vercel: Project → Settings → Environment Variables):
#   VITE_API_URL=https://sniffrweb.onrender.com
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICE_ID=
