NODE_ENV=

# Deployed frontend origin (e.g. https://your-app.vercel.app). Used to build
# links in transactional emails (verification, password reset, admin payment
# review). Leave blank for local dev -- falls back to http://localhost:5173.
CLIENT_URL=

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

//APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=// not yet

STORAGE_TYPE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ORIGINS=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional -- only needed if switching to a domain/transactional provider later:
# SMTP_SECURE=true          # force implicit TLS; auto-detects from port 465 if unset
# SMTP_FROM_EMAIL=noreply@yourdomain.com   # visible sender, defaults to SMTP_USER
# SMTP_FROM_NAME=Sniffr 🐾                  # visible sender name

GOOGLE_PLACES_API_KEY=

//STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=// not yet

# Optional -- TURN relay for 1:1 calls (server/routes/calls.js). Without
# this, calls fall back to STUN-only, which can fail between two peers on
# restrictive/symmetric NAT (most mobile carrier networks). Comma-separated
# list of URLs if your provider gives you more than one (udp/tcp/tls).
# e.g. Metered.ca free tier: TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=