# ============================================================================
# Sniffr — server environment variables
# Copy this file to server/.env and fill in real values. server/config.js
# loads server/.env directly (no dotenv dependency) -- this template must
# live next to it for `cp .env.example server/.env` to make sense, but the
# loader itself only ever reads server/.env, never this file.
# ============================================================================

PORT=3001
NODE_ENV=development

# Deployed frontend origin (e.g. https://your-app.vercel.app). Used to build
# links in transactional emails (verification, password reset, admin payment
# review). Leave blank for local dev -- falls back to http://localhost:5173.
CLIENT_URL=

# postgresql://<user>:<password>@<host>:<port>/<db>
# For local dev, run `npm run db:local` in server/ instead (spawns a
# throwaway local Postgres and prints the DATABASE_URL to use here).
DATABASE_URL=
# Supabase and most managed Postgres hosts require SSL (the default).
# Set to "false" only for a local Postgres with no SSL configured.
DATABASE_SSL=

# Required -- the server refuses to boot without these. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In -- optional, leave blank to disable
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# "local" (default, writes to server/uploads/) or "cloud" (Cloudinary, needs
# the three CLOUDINARY_* vars below)
STORAGE_TYPE=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated allowlist of origins the browser is allowed to call this
# API from (e.g. https://your-app.vercel.app). "*" allows any origin --
# fine for local dev, not recommended in production.
CORS_ORIGINS=*

# Leave blank in dev -- verification links / 2FA codes are logged to the
# console instead of emailed (see server/utils/mailer.js).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional -- only needed if switching to a domain/transactional provider later:
# SMTP_SECURE=true          # force implicit TLS; auto-detects from port 465 if unset
# SMTP_FROM_EMAIL=noreply@yourdomain.com   # visible sender, defaults to SMTP_USER
# SMTP_FROM_NAME=Sniffr 🐾                  # visible sender name

GOOGLE_PLACES_API_KEY=

# Optional -- TURN relay for 1:1 voice/video calls (server/routes/calls.js).
# Without this, calls fall back to STUN-only, which works fine when both
# peers are on the same network/most home networks, but can fail to
# establish media on restrictive/symmetric NAT (common on mobile carrier
# networks) -- signaling will still succeed but no audio/video will flow.
# Comma-separated list of URLs if your provider gives you more than one
# (udp/tcp/tls).
# e.g. Metered.ca free tier: TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
